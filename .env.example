# URL công khai của website (không có dấu / cuối)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# CHỈ phía server. Không bao giờ thêm tiền tố NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (Web application client)
GOOGLE_CLIENT_ID=
# CHỈ phía server
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# ID folder PHIM_WEB trên Drive (phần cuối của URL folder)
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# 32 byte ngẫu nhiên, base64: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Tùy chọn: bật tìm kiếm metadata TMDB trong trang admin
TMDB_API_KEY=

MAX_CONCURRENT_STREAMS=15
MAX_STREAMS_PER_USER=3
